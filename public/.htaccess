# ==============================================================================
# VARDHA WAREHOUSING — HOSTINGER / APACHE PRODUCTION CONFIGURATION
# Client-Side SPA Routing, Asset Caching, Clean URLs & Security Headers
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Prevent rewriting for actual physical files (JS, CSS, images, fonts, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  # 2. Prevent rewriting for actual physical directories
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Route all other requests (clean frontend SPA routes) to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# ==============================================================================
# MIME TYPES & ENCODING
# ==============================================================================
<IfModule mod_mime.c>
  AddType text/html .html
  AddType text/css .css
  AddType application/javascript .js
  AddType application/json .json
  AddType image/svg+xml .svg .svgz
  AddType image/webp .webp
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType font/ttf .ttf
</IfModule>

# ==============================================================================
# BROWSER CACHING FOR OPTIMAL PERFORMANCE
# ==============================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML documents - do not aggressively cache so updates appear immediately
  ExpiresByType text/html "access plus 0 seconds"

  # CSS, JavaScript & Fonts - Vite outputs unique hashes for production assets
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"

  # Media & Images
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

# ==============================================================================
# SECURITY HEADERS
# ==============================================================================
<IfModule mod_headers.c>
  # Protect against MIME sniffing
  Header set X-Content-Type-Options "nosniff"

  # Protect against clickjacking
  Header set X-Frame-Options "SAMEORIGIN"

  # Cross-site scripting filter
  Header set X-XSS-Protection "1; mode=block"

  # Referrer policy
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Ensure index.html is revalidated for instant SPA updates
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
