# ============================================
# VARDHA WAREHOUSING — BACKEND CONFIGURATION
# ============================================

# Server Port
PORT=5000

# Node Environment (development | production)
NODE_ENV=development

# Allowed Frontend URL for CORS
CLIENT_URL=http://localhost:3000

# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas connection string:
# e.g. mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vardha_warehousing?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_connection_string_here

# Resend Email Service Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Verified Sender Email (use onboarding@resend.dev for testing, or your verified domain)
EMAIL_FROM=Vardha Warehousing <onboarding@resend.dev>

# Admin Recipient Email (comma-separated for multiple admins)
EMAIL_TO=vardhawarehousing@gmail.com
